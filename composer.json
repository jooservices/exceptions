{
    "name": "jooservices/exceptions",
    "description": "Shared exception contracts, context-aware bases, and secret redaction for the JOOservices ecosystem.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "exceptions",
        "contracts",
        "context-aware",
        "redaction",
        "logging",
        "jooservices"
    ],
    "authors": [
        {
            "name": "Viet Vu",
            "email": "jooservices@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/jooservices/exceptions/issues",
        "source": "https://github.com/jooservices/exceptions"
    },
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "captainhook/captainhook": "^5.24",
        "captainhook/plugin-composer": "^5.3",
        "laravel/pint": "^1.18",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.0",
        "squizlabs/php_codesniffer": "^3.13.6 || ^4.0.0"
    },
    "autoload": {
        "psr-4": {
            "JOOservices\\Exceptions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JOOservices\\Exceptions\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint:pint": "pint --test",
        "lint:pint:fix": "pint",
        "lint:phpcs": "phpcs --standard=phpcs.xml.dist",
        "lint:phpstan": "XDEBUG_MODE=off phpstan analyse --configuration=phpstan.neon --memory-limit=512M",
        "lint:phpmd": "php -d error_reporting=6143 vendor/bin/phpmd src text phpmd.xml.dist",
        "lint": [
            "@lint:pint",
            "@lint:phpcs",
            "@lint:phpstan"
        ],
        "lint:all": [
            "@lint:pint",
            "@lint:phpcs",
            "@lint:phpstan",
            "@lint:phpmd"
        ],
        "lint:fix": [
            "@lint:pint:fix"
        ],
        "test": "phpunit --no-coverage",
        "test:coverage": "phpunit --coverage-text --coverage-clover build/coverage.xml && php tools/ensure-coverage.php build/coverage.xml 100",
        "docs:verify": "php tools/ensure-docs-snippets.php",
        "check": [
            "@lint:all",
            "@docs:verify",
            "@test"
        ],
        "ci": [
            "@lint:all",
            "@docs:verify",
            "@test:coverage"
        ],
        "post-install-cmd": "captainhook install --force --skip-existing",
        "post-update-cmd": "captainhook install --force --skip-existing"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "captainhook/plugin-composer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
